   </head>
diff --git a/public/.htaccess b/public/.htaccess
index 11b2794..c2702c7 100644
--- a/public/.htaccess
+++ b/public/.htaccess
@@ -1,12 +1,35 @@
 # Used by Apache / LiteSpeed (cPanel). Ignored by other servers. All blocks are optional.
 
+AddDefaultCharset UTF-8
+DirectoryIndex index.html
+Options -Indexes
+
 # Real 404 for unknown URLs (every language has its own static page: no SPA fallback needed)
 ErrorDocument 404 /404.html
-Options -Indexes
+
+# ---------------------------------------------------------------------------
+# One canonical address: https + no "www" + no "/index.html".
+# Without this, the same page exists at several URLs and search engines split its ranking.
+# The conditions also cover Cloudflare / proxies (they talk HTTP to this server), which avoids redirect loops.
+# ---------------------------------------------------------------------------
+<IfModule mod_rewrite.c>
+  RewriteEngine On
+
+  RewriteCond %{HTTPS} !=on
+  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
+  RewriteCond %{HTTP:CF-Visitor} !scheme\W+https
+  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
+
+  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
+  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
+
+  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(.*/)?index\.html[\s?] [NC]
+  RewriteRule ^ /%1 [R=301,L]
+</IfModule>
 
 # Compress text files
 <IfModule mod_deflate.c>
-  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
+  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/ld+json image/svg+xml
 </IfModule>
 
 # Browser caching. JS/CSS file names change on every build (hashed), so a year is safe.
@@ -20,4 +43,20 @@ Options -Indexes
   ExpiresByType image/png "access plus 1 month"
   ExpiresByType image/webp "access plus 1 month"
   ExpiresByType image/svg+xml "access plus 1 month"
+  ExpiresByType image/x-icon "access plus 1 month"
+</IfModule>
+
+<IfModule mod_headers.c>
+  # Hashed build files never change: tell browsers and CDNs they can keep them forever
+  <FilesMatch "\.(js|css)$">
+    Header set Cache-Control "public, max-age=31536000, immutable"
+  </FilesMatch>
+  # HTML / sitemap / robots: always revalidate so a new deploy shows up immediately
+  <FilesMatch "\.(html|xml|txt)$">
+    Header set Cache-Control "no-cache"
+  </FilesMatch>
+
+  Header always set X-Content-Type-Options "nosniff"
+  Header always set Referrer-Policy "strict-origin-when-cross-origin"
+  Header always set X-Frame-Options "SAMEORIGIN"
 </IfModule>
