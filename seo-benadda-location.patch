diff --git a/index.html b/index.html
index 1408f2e..a6a2e1f 100644
--- a/index.html
+++ b/index.html
@@ -4,7 +4,8 @@
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
     <meta name="theme-color" content="#000000" />
-    <!-- Title, description, canonical, hreflang, Open Graph and JSON-LD are generated per language at build time (src/seo/head.js) -->
+    <!-- Title, description, canonical, hreflang, Open Graph and JSON-LD are generated per language at build time (src/seo/head.js).
+         Favicons and the manifest are declared here, once. -->
     <!--app-head-->
     <link rel="icon" href="/favicon.ico" sizes="any" />
     <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
@@ -14,10 +15,19 @@
     <link rel="manifest" href="/site.webmanifest" />
     <link rel="preconnect" href="https://fonts.googleapis.com" />
     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+    <!-- Fonts load without blocking the first paint (media=print trick); display=swap shows text immediately -->
     <link
       rel="stylesheet"
       href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..900&family=Cairo:wght@400..900&display=swap"
+      media="print"
+      onload="this.media='all'"
     />
+    <noscript>
+      <link
+        rel="stylesheet"
+        href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..900&family=Cairo:wght@400..900&display=swap"
+      />
+    </noscript>
     <!-- Without JavaScript, show the content the entrance animations start hidden -->
