# Where car data comes from: json (default) | supabase | api
VITE_CARS_PROVIDER=json

# --- supabase ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_SUPABASE_BUCKET=car-images

# --- api (any endpoint returning an array of cars, e.g. Strapi, Firebase function, your own backend) ---
VITE_CARS_API_URL=https://example.com/api/cars
